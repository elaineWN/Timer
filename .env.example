# Supabase Configuration
# Copy this file to .env.local and fill in your actual values

# Your Supabase project URL (found in Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (found in Settings > API)
# DO NOT use the service_role key in frontend code
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Debug logging level
# VITE_LOG_LEVEL=debug

# Optional: Enable mock data for testing
# VITE_ENABLE_MOCK=false
